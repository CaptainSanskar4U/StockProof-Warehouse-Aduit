{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/gov-checks",
      "destination": "/api/checks"
    },
    {
      "source": "/api/gov-checks/:id",
      "destination": "/api/checks?id=:id"
    },
    {
      "source": "/api/farmer-checks",
      "destination": "/api/checks"
    },
    {
      "source": "/api/farmer-checks/:id",
      "destination": "/api/checks?id=:id"
    },
    {
      "source": "/api/reviews/:id",
      "destination": "/api/reviews?id=:id"
    },
    {
      "source": "/api/warehouses/:id",
      "destination": "/api/warehouses?id=:id"
    },
    {
      "source": "/((?!api/|assets/|.*\\.png$|.*\\.jpe?g$|.*\\.svg$|.*\\.ico$|.*\\.webp$|.*\\.woff2?$|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai-detect.ts": {
      "memory": 512,
      "maxDuration": 120
    },
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 10
    }
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai-detect.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/ai-detect-crosscheck.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 10
    }
  }
}
